# Telegram bot token — create a bot at https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# football-data.org API key — register at https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=your_football_data_api_key_here

# SQLite database path (relative to working directory)
DATABASE_URL=sqlite:///./data/app.db

# How often to poll for match results (seconds). Default: 300 (5 min).
# football-data.org free tier allows 10 req/min — don't go below 60.
POLL_INTERVAL_SECONDS=300

# Admin Telegram chat ID — receives new-user notifications and can run /users
ADMIN_TELEGRAM_CHAT_ID=your_admin_chat_id_here

# Scoring config — points per match, configurable per tournament stage
# Points are cumulative: sign + goal_diff + exact (max = sum of all three)
# Defaults: 1 / 1 / 2 = max 4 pts per match (standard Porra Mundial scoring)
#
#                        SIGN  GOAL_DIFF  EXACT
POINTS_GROUP_SIGN=1
POINTS_GROUP_GOAL_DIFF=1
POINTS_GROUP_EXACT=2

POINTS_R32_SIGN=1
POINTS_R32_GOAL_DIFF=1
POINTS_R32_EXACT=2

POINTS_R16_SIGN=1
POINTS_R16_GOAL_DIFF=1
POINTS_R16_EXACT=2

POINTS_QF_SIGN=1
POINTS_QF_GOAL_DIFF=1
POINTS_QF_EXACT=2

POINTS_SF_SIGN=1
POINTS_SF_GOAL_DIFF=1
POINTS_SF_EXACT=2

POINTS_3RD_SIGN=1
POINTS_3RD_GOAL_DIFF=1
POINTS_3RD_EXACT=2

POINTS_FINAL_SIGN=1
POINTS_FINAL_GOAL_DIFF=1
POINTS_FINAL_EXACT=2

# Debug mode (enables FastAPI auto-reload and verbose logging)
DEBUG=false

# HTTPS / Nginx (optional — only used when starting with --profile https)
# APP_PORT=8000          # host port the web container is exposed on
# HTTP_PORT=80           # Nginx HTTP port (redirects to HTTPS)
# HTTPS_PORT=443         # Nginx HTTPS port
# SSL_CERT=/path/to/fullchain.pem
# SSL_KEY=/path/to/privkey.pem
